# VANRAKSHA AI — Example environment file
# Copy to .env and override values as needed.
# NEVER commit .env with real secrets.

# App
APP_NAME=VANRAKSHA AI
DEBUG=false
ENVIRONMENT=development

# Database (PostGIS required)
DATABASE_URL=postgresql+psycopg://vanraksha:vanraksha@localhost:5432/vanraksha

# Auth
SECRET_KEY=changeme-in-production
CORS_ORIGINS=["http://localhost:3000"]
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Edge / Demo
EDGE_MODE=false
DEMO_MODE=true
ALLOW_AGPL=false

# Paths
MODELS_DIR=./models
EVIDENCE_DIR=./evidence
SAMPLE_FPS=2.0

# Time / Night window
NIGHT_START=18:00
NIGHT_END=06:00
TIMEZONE=Asia/Kolkata

# Ranger proximity
RANGER_PROXIMITY_RADIUS_M=500.0
RANGER_LOCATION_SKEW_MINUTES=15

# Vision backends (default: dummy/IOU for tests)
DETECTOR_BACKEND=dummy
TRACKER_BACKEND=iou
SPECIES_BACKEND=null

# Camera health
OFFLINE_AFTER_SECONDS=30

# Incident threshold
INCIDENT_MIN_LEVEL=medium

# Evidence
RESTRICT_EVIDENCE=true

# Sync (edge → central)
SYNC_URL=