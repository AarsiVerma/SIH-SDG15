# VANRAKSHA AI — Example environment file
# Copy to .env and override values as needed.
# NEVER commit .env with real secrets.

# App
APP_NAME=VANRAKSHA AI
DEBUG=false
ENVIRONMENT=development

# Database (PostGIS required)
DATABASE_URL=postgresql+psycopg://vanraksha:vanraksha@localhost:5432/vanraksha

# Auth
SECRET_KEY=changeme-in-production
CORS_ORIGINS=["http://localhost:3000"]
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Edge / Demo
EDGE_MODE=false
DEMO_MODE=true
ALLOW_AGPL=false

# Paths
MODELS_DIR=./models
EVIDENCE_DIR=./evidence
SAMPLE_FPS=2.0

# Time / Night window
NIGHT_START=18:00
NIGHT_END=06:00
TIMEZONE=Asia/Kolkata

# Ranger proximity
RANGER_PROXIMITY_RADIUS_M=500.0
RANGER_LOCATION_SKEW_MINUTES=15

# Vision backends
# Options: megadetector (recommended), onnx, dummy
DETECTOR_BACKEND=megadetector
# Options: bytetrack, iou
TRACKER_BACKEND=bytetrack
SPECIES_BACKEND=null

# Camera health
OFFLINE_AFTER_SECONDS=30

# Incident threshold
INCIDENT_MIN_LEVEL=medium

# Evidence
RESTRICT_EVIDENCE=true

# Sync (edge -> central)
SYNC_URL=

# Retention periods (days)
DETECTION_RETENTION_DAYS=30
TRACK_POINTS_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90
CAMERA_HEALTH_RETENTION_DAYS=30
RANGER_LOCATION_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90
SYNC_OUTBOX_RETENTION_DAYS=30